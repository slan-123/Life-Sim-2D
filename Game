def show_choice_event_popup(title, description, choices):
    waiting = True
    selected_choice = None

    while waiting:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_1 and len(choices) >= 1:
                    selected_choice = 0
                    waiting = False

                elif event.key == pygame.K_2 and len(choices) >= 2:
                    selected_choice = 1
                    waiting = False

                elif event.key == pygame.K_3 and len(choices) >= 3:
                    selected_choice = 2
                    waiting = False

            if event.type == pygame.MOUSEBUTTONDOWN:
                for i, choice in enumerate(choices):
                    choice_rect = pygame.Rect(175, 390 + i * 60, 450, 50)

                    if choice_rect.collidepoint(event.pos):
                        selected_choice = i
                        waiting = False

        # Background
        WIN.fill(bg_color)

        # Dark overlay
        overlay = pygame.Surface((WIDTH, HEIGHT))
        overlay.set_alpha(120)
        overlay.fill(BLACK)
        WIN.blit(overlay, (0, 0))

        # Day/night colours
        if time_of_day == "Night":
            card_color = (35, 35, 55)
            text_color = WHITE
            border_color = (90, 90, 130)
            button_color = (70, 70, 130)
        else:
            card_color = WHITE
            text_color = BLACK
            border_color = DARK_BLUE
            button_color = BLUE

        # Event card
        card = pygame.Rect(125, 70, 550, 500)

        pygame.draw.rect(WIN, card_color, card, border_radius=20)
        pygame.draw.rect(WIN, border_color, card, 4, border_radius=20)

        # Title
        title_text = BIG_FONT.render(title, True, text_color)
        title_rect = title_text.get_rect(center=(WIDTH // 2, 125))
        WIN.blit(title_text, title_rect)

        # Description
        description_text = FONT.render(description, True, text_color)
        description_rect = description_text.get_rect(center=(WIDTH // 2, 210))
        WIN.blit(description_text, description_rect)

        # Choices
        for i, choice in enumerate(choices):
            choice_rect = pygame.Rect(175, 390 + i * 60, 450, 50)

            pygame.draw.rect(
                WIN,
                button_color,
                choice_rect,
                border_radius=12
            )

            choice_text = FONT.render(
                f"{i + 1}. {choice}",
                True,
                WHITE
            )

            choice_text_rect = choice_text.get_rect(
                center=choice_rect.center
            )

            WIN.blit(choice_text, choice_text_rect)

        pygame.display.update()
        clock.tick(60)

    return selected_choice

def draw_stat_bar(x, y, w, h, value, max_value, color, label):
    pygame.draw.rect(WIN, BLACK, (x - 2, y - 2, w + 4, h + 4))
    pygame.draw.rect(WIN, GRAY, (x, y, w, h))
    fill_width = int((value / max_value) * w) if max_value != 0 else 0
    pygame.draw.rect(WIN, color, (x, y, fill_width, h))
    WIN.blit(FONT.render(label, True, BLACK), (x + w + 10, y))


