def career_xp_required(level):
    return level * 100
def get_career_title(level):
    if level == 1:
        return "Beginner"
    elif level == 2:
        return "Apprentice"
    elif level == 3:
        return "Skilled"
    elif level == 4:
        return "Professional"
    elif level == 5:
        return "Expert"
    elif level == 6:
        return "Veteran"
    elif level == 7:
        return "Master"
    elif level == 8:
        return "Elite"
    elif level == 9:
        return "Legend"
    else:
        return "Grandmaster"
def get_career_pay_bonus(level):
    if level <= 4:
        return level * 10
    else:
        return 40 + (level - 4) * 20
def check_career_level_up(job):
    career = career_data[job]

    while career["xp"] >= career_xp_required(career["level"]):
        career["xp"] -= career_xp_required(career["level"])
        career["level"] += 1

        show_message(
            f"{job.replace('_', ' ').title()} reached Level {career['level']}!",
            GREEN
        )
