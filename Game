        programmer_btn.draw(WIN)
        gambler_btn.draw(WIN)

        chef_btn.draw(WIN)
        delivery_btn.draw(WIN)
        streamer_btn.draw(WIN)

        rhythm_btn.draw(WIN)
        fishing_btn.draw(WIN)
        gd_runner_btn.draw(WIN)

        # Job descriptions
        description_color = muted_color

        descriptions = [
            ("£10–£20", 70, 225),
            ("£30–£80", 295, 225),
            ("−£50–£200", 520, 225),

            ("£15–£40", 70, 315),
            ("£20–£60", 295, 315),
            ("£5–£100", 520, 315),

            ("£50–£100", 70, 405),
            ("£5–£120", 295, 405),
            ("£50–£120", 520, 405)
        ]

        for text, x, y in descriptions:

            income_text = FONT.render(
                text,
                True,
                description_color
            )

            income_rect = income_text.get_rect(
                center=(x + 105, y)
            )

            WIN.blit(
                income_text,
                income_rect
            )

        # Footer
        instruction = FONT.render(
            "Click a job to start working    |    ESC to cancel",
            True,
            muted_color
        )

        instruction_rect = instruction.get_rect(
            center=(WIDTH // 2, 535)
        )

        WIN.blit(
            instruction,
            instruction_rect
        )

        pygame.display.update()

        # Events
        for event in pygame.event.get():

            if event.type == pygame.QUIT:

                pygame.quit()
                sys.exit()

            if event.type == pygame.KEYDOWN:

                if event.key == pygame.K_ESCAPE:

                    choosing = False

            if event.type == pygame.MOUSEBUTTONDOWN:

                if cashier_btn.is_clicked(event.pos):

                    chosen_job = "cashier"
                    chosen_income = cashier_minigame()
                    choosing = False

                elif programmer_btn.is_clicked(event.pos):

                    chosen_job = "programmer"
                    chosen_income = programmer_minigame()
                    choosing = False

                elif gambler_btn.is_clicked(event.pos):

                    chosen_job = "gambler"
                    chosen_income = gambler_minigame()
                    choosing = False

                elif chef_btn.is_clicked(event.pos):

                    chosen_job = "chef"
                    chosen_income = chef_minigame()
                    choosing = False

                elif delivery_btn.is_clicked(event.pos):

                    chosen_job = "delivery"
                    chosen_income = delivery_minigame()
                    choosing = False

                elif streamer_btn.is_clicked(event.pos):

                    chosen_job = "streamer"
                    chosen_income = streamer_minigame()
                    choosing = False

                elif rhythm_btn.is_clicked(event.pos):

                    chosen_job = "rhythm"
                    chosen_income = rhythm_minigame()
                    choosing = False

                elif fishing_btn.is_clicked(event.pos):

                    chosen_job = "fishing"
                    chosen_income = fishing_minigame()
                    choosing = False

                elif gd_runner_btn.is_clicked(event.pos):

                    chosen_job = "gd_runner"
                    chosen_income = gd_runner_minigame()
                    choosing = False

        clock.tick(60)

    # Cancelled
    if chosen_job is None:
        return

    # Career progression
    career_level = career_data[chosen_job]["level"]
    pay_bonus = get_career_pay_bonus(career_level)

    if chosen_income > 0:

        chosen_income = int(
            chosen_income * (1 + pay_bonus / 100)
        )

    Balance += chosen_income

    hunger -= 2
    energy -= 2

    # Career XP
    job_xp = 50
    career_data[chosen_job]["xp"] += job_xp

    check_career_level_up(chosen_job)

    # Random event
    random_event()

    # Advance day
    day += 1

    # Housing costs
    housing_cost = housing_options[current_home]["daily_cost"]
    Balance = max(0, Balance - housing_cost)

    # Housing bonuses
    energy_bonus = housing_options[current_home]["energy_bonus"]
    health_bonus = housing_options[current_home]["health_bonus"]

    energy = min(10, energy + energy_bonus)
    health = min(10, health + health_bonus)

    # Update game systems
    update_season()
    update_daily_prices()
    exhaustion_penalty()
    check_achievements()


def save_game():
    with open("save.json", "w") as f:
        json.dump({
            "Balance": Balance,
            "hunger": hunger,
            "energy": energy,
            "health": health,
            "day": day,
            "time_of_day": time_of_day,
            "inventory_foods": inventory_foods,
            "inventory_energy": inventory_energy,
            "current_home": current_home,
            "career_data": career_data
        }, f)
    show_message("Game saved!")

def load_game():
    global Balance, hunger, energy, health, day, time_of_day, inventory_foods, inventory_energy, current_home, career_data
    try:
        with open("save.json") as f:
            data = json.load(f)
        Balance = data["Balance"]
        hunger = data["hunger"]
        energy = data["energy"]
        health = data["health"]
        day = data["day"]
        time_of_day = data["time_of_day"]
        current_home = data.get("current_home", "Shared Room")
        career_data = data.get("career_data", career_data)
        inventory_foods = data.get("inventory_foods", inventory_foods)
        inventory_energy = data.get("inventory_energy", inventory_energy)
        update_season()
        update_daily_prices()
        check_achievements()
        show_message("Game loaded!")
    except FileNotFoundError:
        show_message("No saved game found.", RED)

def toggle_time(new_time):
    global time_of_day
    time_of_day = new_time
    show_message(f"It is now {time_of_day}")


def start_menu():
    menu_running = True
    start_btn = Button(300, 250, 200, 60, "Start Game", color=GREEN)
    quit_btn = Button(300, 350, 200, 60, "Quit", color=RED)

    while menu_running:
        WIN.fill(day_color)
        WIN.blit(BIG_FONT.render("Life Simulator 2D", True, BLACK), (220, 100))
        start_btn.draw(WIN)
        quit_btn.draw(WIN)
        pygame.display.update()

        for event in pygame.event.get():
            if event.type == pygame.QUIT: pygame.quit(); sys.exit()
            if event.type == pygame.MOUSEBUTTONDOWN:
                if start_btn.is_clicked(event.pos):
                    menu_running = False
                elif quit_btn.is_clicked(event.pos):
                    pygame.quit(); sys.exit()


update_season()
update_daily_prices()


clock = pygame.time.Clock()
start_menu()
