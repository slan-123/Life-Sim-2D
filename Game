def update_background(target):
    global bg_color
    r, g, b = bg_color.r, bg_color.g, bg_color.b
    tr, tg, tb = target.r, target.g, target.b
    if r < tr: r += 2
    elif r > tr: r -= 2
    if g < tg: g += 2
    elif g > tg: g -= 2
    if b < tb: b += 2
    elif b > tb: b -= 2
    bg_color = pygame.Color(r, g, b)


